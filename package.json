{
  "author": "Pauan <pauanyu+github@pm.me>",
  "name": "saltybetbot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "records": "cargo run --release -p process-records",
    "test": "npm run test:js && npm run test:rust",
    "test:js": "vitest run",
    "test:rust": "cargo test -p algorithm",
    "test:browser": "node tests/browser/extension-smoke.mjs",
    "test:parser": "node scripts/test-parser.mjs",
    "verify": "npm test && npm run test:parser && npm run build && node scripts/verify-build.mjs && npm run test:browser"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.2",
    "playwright": "^1.62.1",
    "vitest": "^3.2.4"
  }
}
